# AmberStream lab service configuration.
#
# install.sh copies this to deploy/amberstream.env and fills in a SECRET_KEY.
# That copy is gitignored: it is the only place a real address or secret should
# ever be written, so nothing environment-specific reaches the repository.

# --- Where the site listens ---------------------------------------------
#
#   auto        Bind this VM's own primary address, worked out at service
#               start from the default-route interface. This is the default,
#               and it means a cloned golden image needs no per-VM edit.
#
#   127.0.0.1   Loopback only - reachable from inside this VM and nowhere else.
#
#   <an address>  Pin it by hand, if this VM has several interfaces and the
#                 automatic choice picks the wrong one.
#
# Do NOT set 0.0.0.0. This build is deliberately vulnerable, and 0.0.0.0 would
# publish it on every interface the VM happens to have.
BIND_ADDR=auto

# 80 serves the site at http://<hostname>/ with no port in the URL. The systemd
# unit grants CAP_NET_BIND_SERVICE, so this does not need root.
PORT=80

# Seconds to wait for the network to come up before giving up and using
# loopback. Boot order is not guaranteed.
BIND_WAIT=30

# Flask session signing key. install.sh generates a random one.
SECRET_KEY=change-me
